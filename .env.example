# Copie este arquivo para .env e preencha com os valores reais.
# Atenção: toda variável com prefixo VITE_ vai para o JavaScript do navegador,
# ou seja, é PÚBLICA. Nunca coloque segredo (senha, token, chave privada) aqui.

# URL pública do site, sem barra no final (usada em canonical e Open Graph)
VITE_SITE_URL=https://exemplo.com.br

# WhatsApp do studio, só dígitos, com DDI e DDD (ex: 5531999999999)
VITE_WHATSAPP_NUMBER=

# Perfil do Instagram do studio
VITE_INSTAGRAM_URL=https://www.instagram.com/usuario
